# =========================================================================
#  Insta Post Auto — Configuration
#  Copie ce fichier en `.env` et remplis les valeurs.
# =========================================================================

# --- Serveur ---------------------------------------------------------------
# URL publique de l'app. OBLIGATOIRE pour la publication Instagram :
# l'API Graph va chercher les images via une URL publiquement accessible.
# En local tu peux utiliser un tunnel (ngrok, cloudflared) :
#   PUBLIC_BASE_URL=https://ton-tunnel.ngrok.io
PUBLIC_BASE_URL=http://localhost:8000

# --- Génération de texte (Claude / Anthropic) ------------------------------
ANTHROPIC_API_KEY=
# Modèle utilisé pour générer hooks & captions.
TEXT_MODEL=claude-sonnet-4-6

# --- Génération d'images (OpenAI / DALL-E) ---------------------------------
# Optionnel. Sans clé, l'app utilise uniquement ton image de marque comme fond.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- Instagram Graph API ---------------------------------------------------
# Compte Business/Creator lié à une Page Facebook + app Meta.
# Token longue durée (~60 jours, renouvelable).
IG_ACCESS_TOKEN=
# ID du compte Instagram Business (PAS le username).
IG_BUSINESS_ACCOUNT_ID=
# Version de l'API Graph.
IG_GRAPH_VERSION=v21.0

# --- Scheduler -------------------------------------------------------------
# Fuseau horaire pour la planification.
SCHEDULER_TIMEZONE=Europe/Zurich
# Active le worker d'auto-post (true/false).
AUTOPOST_ENABLED=true
